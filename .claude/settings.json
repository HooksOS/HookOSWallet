{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(curl -s *)",
      "Bash(yarn lint:*)",
      "Bash(yarn lint:ts)",
      "Bash(yarn lint:js)",
      "Bash(yarn test:*)",
      "Bash(yarn jest:*)",
      "Bash(yarn tsc:*)",
      "Bash(yarn check:cycles)",
      "Bash(yarn madge:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git stash list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh repo view:*)"
