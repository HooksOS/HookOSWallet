# HookOS WALLET-owned Infura API — env template. Copy to api/.env on the host (chmod 600).
# Read-only service: NO prod secrets. Generate a fresh API key; use public RPCs + public indexer.
#   API_KEYS=$(openssl rand -hex 24)
PORT=8080
API_KEYS=                                   # generated; sent via x-hookos-infura-key header
CORS_ORIGINS=https://wallet.hookoswallet.xyz
BASE_RPC_URL=https://mainnet.base.org
MEGAETH_RPC_URL=https://mainnet.megaeth.com/rpc
HOOKOS_INDEXER_URL=https://api.hookos.fun
INDEXER_TIMEOUT_MS=8000
